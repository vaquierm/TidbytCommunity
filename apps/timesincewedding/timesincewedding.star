"""
Applet: Countdown Clock
Summary: Countdown to an event
Description: Display the days, hours, and minutes remaining to a specified event.
Author: CubsAaron
"""

load("math.star", "math")
load("render.star", "render")
load("schema.star", "schema")
load("time.star", "time")
load("encoding/base64.star", "base64")

def main(config):
    timezone = config.get("$tz", "America/Chicago")  # Utilize special timezone variable
    DEFAULT_TIME = time.now().in_location(timezone).format("2006-01-02T15:04:05Z07:00")

    weddingTime = time.parse_time(config.str("event_time", DEFAULT_TIME))
    dateDiff = time.now().in_location(timezone) - weddingTime
    years = math.floor(dateDiff.hours / (24 * 365))
    days = math.floor(dateDiff.hours / 24 - years * 365)

    fadeList = []  # The list of the fading text near the bottom, or a static date if the event has passed

    # Create the lists that will make the fading text
    dayString = "{} {}".format(str(days), "Day" if days == 1 else "Days")
    fadeList = appendFadeList(fadeList, "{} {}".format(str(years), "year" if years == 1 else "years"), 30)
    fadeList = appendFadeList(fadeList, "{} {}".format(str(days), "day" if days == 1 else "days"), 20)

    # Create event text widget based on text length
    adamTess = config.str("event", "Event")
    adamTess = "Tess+Adam"
    eventWidget = render.Text(content = adamTess, font = "6x13", color = "#00B000")
    marriedSinceText = render.Text(content = "Married since", color="#fff")

    animationFrames = [render.Image(src=base64.decode(image_frame), width=64, height=32) for image_frame in IMAGE_FRAMES]

    finalFrame = render.Column(
        expanded = True,
        main_align = "center",
        cross_align = "center",
        children = [
            eventWidget,
            marriedSinceText,
            render.Box(width = 64, height = 3),
            render.Animation(
                children = fadeList,
            ),
        ],
    )

    for i in range(0, 3):
        animationFrames.append(render.Box(color="#000", height=32, width=64))

    for i in range(0, 100):
        animationFrames.append(finalFrame)

    return render.Root(
        delay = 100,
        child = render.Stack(
            children=
            [
                render.Animation(
                    children=animationFrames
                )
            ]
        )
    )

# Create an fading animation
def appendFadeList(fadeList, text, cycles):
    for x in range(0, 10, 2):
        c = "#" + str(x) + str(x) + str(x) + str(x) + str(x) + str(x)
        fadeList.append(render.Text(text, font = "CG-pixel-4x5-mono", color = c))
    for x in range(cycles):
        fadeList.append(render.Text(text, font = "CG-pixel-4x5-mono", color = "#888888"))
    for x in range(8, 0, -2):
        c = "#" + str(x) + str(x) + str(x) + str(x) + str(x) + str(x)
        fadeList.append(render.Text(text, font = "CG-pixel-4x5-mono", color = c))
    return fadeList

def get_schema():
    return schema.Schema(
        version = "1",
        fields = [
            schema.DateTime(
                id = "event_time",
                name = "Event Time",
                desc = "The time of the event.",
                icon = "gear",
            )
        ],
    )

